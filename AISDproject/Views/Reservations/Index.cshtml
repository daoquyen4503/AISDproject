@model IEnumerable<AISDproject.Models.Reservation>

@{
    ViewData["Title"] = "Reservation List";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #1d3557;
        margin-bottom: 20px;
    }

    .btn-danger-custom {
        background-color: #c92a2a;
        border-color: #c92a2a;
        color: white;
        padding: 8px 24px;
        font-weight: 500;
        font-size: 14px;
    }

        .btn-danger-custom:hover {
            background-color: #a61e1e;
            border-color: #a61e1e;
        }

    .table th, .table td {
        vertical-align: middle !important;
    }

    .action-btns .btn {
        padding: 4px 10px;
    }
</style>

<section class="py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title">📋 Reservation List</h2>
            <a asp-action="Create" class="btn btn-danger-custom rounded-pill shadow">
                <i class="bi bi-plus-circle me-1"></i> Add Reservation
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="text-white text-center" style="background-color: #dc3545;">
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Date</th>
                                <th>Table</th>
                                <th>Time Slot</th>
                                <th>Status</th>
                                <th style="width: 160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="bi bi-info-circle me-2"></i> No reservations found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.CustomerName</td>
                                        <td>@item.PhoneNumber</td>
                                        <td>@item.ReservationDate.ToString("dd/MM/yyyy")</td>
                                        <td>@item.Table?.TableName</td>
                                        <td>
                                            @item.TimeSlot?.StartTime.ToString(@"hh\:mm")
                                            -
                                            @item.TimeSlot?.EndTime.ToString(@"hh\:mm")
                                        </td>
                                        <td>@item.Status</td>
                                        <td class="text-center action-btns">
                                            <a asp-action="Edit" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-warning rounded-circle" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-info rounded-circle" title="Details">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.ReservationId" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
