@model AISDproject.Models.Reservation

@{
    ViewData["Title"] = "Edit Reservation";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .edit-container {
        background-color: #f8f9fa;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        padding: 30px;
        max-width: 600px;
        margin: auto;
    }

    .form-label {
        font-weight: 600;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #1d3557;
        margin-bottom: 20px;
        text-align: center;
    }

    .btn-primary-custom {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
        padding: 8px 24px;
        font-weight: 500;
    }

    .btn-outline-custom {
        color: #6c757d;
        border-color: #ced4da;
        padding: 8px 24px;
    }

        .btn-outline-custom:hover {
            background-color: #e9ecef;
        }
</style>

<section class="py-5">
    <div class="container" data-aos="fade-up">
        <h2 class="section-title">Edit Reservation</h2>

        <div class="edit-container">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReservationId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="CustomerName" class="form-label">Customer Name</label>
                    <input asp-for="CustomerName" class="form-control rounded-pill px-3" />
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                    <input asp-for="PhoneNumber" class="form-control rounded-pill px-3" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ReservationDate" class="form-label">Reservation Date</label>
                    <input asp-for="ReservationDate" type="date" class="form-control rounded-pill px-3" />
                    <span asp-validation-for="ReservationDate" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TableId" class="form-label">Table</label>
                    <select asp-for="TableId" asp-items="ViewBag.TableList" class="form-select rounded-pill px-3">
                        <option value="">-- Select Table --</option>
                    </select>
                    <span asp-validation-for="TableId" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TimeSlotId" class="form-label">Time Slot</label>
                    <select asp-for="TimeSlotId" asp-items="ViewBag.TimeSlotList" class="form-select rounded-pill px-3">
                        <option value="">-- Select Time Slot --</option>
                    </select>
                    <span asp-validation-for="TimeSlotId" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select rounded-pill px-3" asp-items="Html.GetEnumSelectList<ReservationStatus>()">
                        <option value="">-- Select Status --</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-custom rounded-pill">Back</a>
                    <button type="submit" class="btn btn-primary-custom rounded-pill">Save</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
