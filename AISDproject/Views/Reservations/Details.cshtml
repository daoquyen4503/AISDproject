@model AISDproject.Models.Reservation

@{
    ViewData["Title"] = "Reservation Details";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .details-container {
        background-color: #f8f9fa;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        padding: 30px;
        max-width: 600px;
        margin: auto;
    }

    dt {
        font-weight: 600;
        color: #1d3557;
    }

    dd {
        margin-bottom: 1rem;
        color: #333;
    }

    .btn-outline-secondary-custom {
        font-size: 14px;
        padding: 8px 20px;
        color: #6c757d;
        border: 1px solid #ced4da;
    }

        .btn-outline-secondary-custom:hover {
            background-color: #f1f3f5;
        }

    .btn-primary-custom {
        background-color: #0d6efd;
        border-color: #0d6efd;
        color: #fff;
        font-size: 14px;
        padding: 8px 24px;
        font-weight: 500;
    }

        .btn-primary-custom:hover {
            background-color: #0b5ed7;
            border-color: #0a58ca;
        }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #1d3557;
        margin-bottom: 20px;
        text-align: center;
    }
</style>

<section class="py-4">
    <div class="container">
        <h2 class="section-title">Reservation Details</h2>

        <div class="details-container">
            <dl class="row mb-0">
                <dt class="col-sm-4">Customer Name</dt>
                <dd class="col-sm-8">@Model.CustomerName</dd>

                <dt class="col-sm-4">Phone Number</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>

                <dt class="col-sm-4">Date</dt>
                <dd class="col-sm-8">@Model.ReservationDate.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4">Table</dt>
                <dd class="col-sm-8">@Model.Table?.TableName</dd>

                <dt class="col-sm-4">Time Slot</dt>
                <dd class="col-sm-8">
                    @Model.TimeSlot?.StartTime.ToString(@"hh\:mm") - @Model.TimeSlot?.EndTime.ToString(@"hh\:mm")
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">@Model.Status</dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary-custom rounded-pill">Back</a>
                <a asp-action="Edit" asp-route-id="@Model.ReservationId" class="btn btn-primary-custom rounded-pill">Edit</a>
            </div>
        </div>
    </div>
</section>
