@model AISDproject.Models.Staff

@{
    ViewData["Title"] = "Delete Staff";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card shadow p-4 rounded-4 border-0 bg-light">
            <h2 class="text-center text-danger fw-bold mb-4">Delete Staff</h2>

            <h5 class="text-warning text-center mb-4">Are you sure you want to delete this staff member?</h5>

            <dl class="row">
                <dt class="col-sm-3 fw-semibold">Full Name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3 fw-semibold">Role</dt>
                <dd class="col-sm-9">@Model.Role</dd>

                <dt class="col-sm-3 fw-semibold">Username</dt>
                <dd class="col-sm-9">@Model.Username</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="StaffId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <input type="submit" value="Delete" class="btn btn-danger rounded-pill px-4" />
                </div>
            </form>
        </div>
    </div>
</section>
