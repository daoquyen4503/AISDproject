<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AISDproject</title>

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/assets/vendor/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/assets/vendor/boxicons/css/boxicons.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/glightbox/css/glightbox.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/swiper/swiper-bundle.min.css" />
    <link rel="stylesheet" href="~/assets/css/style.css" />
</head>

<body>

    <!-- ======= Header/Navbar ======= -->
    <header id="header" class="header fixed-top d-flex align-items-center">
        <div class="container-fluid d-flex align-items-center justify-content-between">

            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto me-lg-0">
                <h1>Yummy<span>.</span></h1>
            </a>

            <!-- Navbar -->
            <nav id="navbar" class="navbar navmenu">
                <ul>
                    <li><a class="nav-link scrollto active" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link scrollto" href="#about">About</a></li>
                    <li><a class="nav-link scrollto" asp-controller="MenuItems" asp-action="Index">Menu</a></li>
                    <li><a class="nav-link scrollto" href="#events">Events</a></li>
                    <li><a class="nav-link scrollto" href="#chefs">Chefs</a></li>
                    <li><a class="nav-link scrollto" href="#gallery">Gallery</a></li>
                    <li class="dropdown">
                        <a href="#"><span>Dropdown</span> <i class="bi bi-chevron-down dropdown-indicator"></i></a>
                        <ul>
                            <li><a href="#">Drop Down 1</a></li>
                            <li><a href="#">Drop Down 2</a></li>
                            <li><a href="#">Drop Down 3</a></li>
                        </ul>
                    </li>
                    <li><a class="nav-link scrollto" href="#contact">Contact</a></li>
                </ul>
                <i class="bi bi-list mobile-nav-toggle"></i>
            </nav>

            <!-- Book a Table Button -->
            <a asp-controller="Reservation" asp-action="Create" class="btn-book-a-table d-none d-lg-flex">Book a Table</a>

        </div>
    </header>

    <main id="main" style="margin-top: 100px;">
        @RenderBody()
    </main>

    <!-- ======= Footer ======= -->
    <footer id="footer">
        <div class="container py-4">
            <div class="copyright">
                &copy; 2025 <strong><span>AISDproject</span></strong>. All Rights Reserved
            </div>
        </div>
    </footer>

    <!-- ======= Scripts ======= -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
