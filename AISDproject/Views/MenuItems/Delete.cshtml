@model AISDproject.Models.MenuItem

@{
    ViewData["Title"] = "Delete Menu Item";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">🗑️ Delete Menu Item</h2>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">← Back to List</a>
        </div>

        <div class="alert alert-warning p-4 rounded-4 shadow-sm">
            <h5 class="fw-bold">Are you sure you want to delete this item?</h5>
            <p class="mb-0">This action cannot be undone.</p>
        </div>

        <div class="card shadow-sm p-4 rounded-4 mb-4">
            <h5 class="text-primary fw-bold mb-3">🍽️ Menu Item Details</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">$@Model.Price.ToString("N2")</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category?.Name</dd>

                <dt class="col-sm-3">Image</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="Menu Image" class="img-thumbnail rounded shadow-sm" style="max-width: 180px;" />
                    }
                    else
                    {
                        <span class="text-muted">No image available</span>
                    }
                </dd>
            </dl>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MenuItemId" />
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <input type="submit" value="Delete" class="btn btn-danger rounded-pill px-4" />
            </div>
        </form>
    </div>
</section>
