@model AISDproject.Models.MenuItem

@{
    ViewData["Title"] = "Edit Menu Item";
}

<style>
    .form-wrapper {
        max-width: 650px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
        padding: 40px;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
        height: 44px;
        font-size: 14px;
    }

    .btn-primary-custom {
        background-color: #c92a2a;
        border: none;
        padding: 10px 26px;
        border-radius: 50px;
        font-weight: 500;
    }

        .btn-primary-custom:hover {
            background-color: #a61e1e;
        }

    .btn-outline-secondary-custom {
        padding: 10px 22px;
        border-radius: 50px;
        font-weight: 500;
    }

    .section-title {
        font-size: 28px;
        font-weight: 700;
        text-align: center;
        color: #1d3557;
        margin-bottom: 30px;
    }
</style>

<section class="py-5 bg-light mb-5">
    <div class="container">
        <div class="form-wrapper">
            <h2 class="section-title">Edit Menu Item</h2>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MenuItemId" />
                <input type="hidden" asp-for="ImageUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Price -->
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Price</label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <!-- Category Dropdown -->
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
                        <option value="">-- Select Category --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <!-- Current Image -->
                <div class="mb-3 text-center">
                    <label class="form-label">Current Image</label><br />
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="Current Image" width="150" height="150" class="rounded shadow-sm" style="object-fit: cover;" />
                    }
                    else
                    {
                        <span>No image uploaded</span>
                    }
                </div>

                <!-- Upload New Image -->
                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Upload New Image (optional)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <!-- Status Dropdown -->
                <div class="mb-4">
                    <label asp-for="Status" class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="true" selected="@Model.Status">Available</option>
                        <option value="false" selected="@(!Model.Status)">Unavailable</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary-custom btn-outline-secondary">
                        ← Back
                    </a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-save me-1"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
