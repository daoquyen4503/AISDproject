@model IEnumerable<AISDproject.Models.MenuItem>

@{
    ViewData["Title"] = "Menu Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="menu section-bg">
    <div class="container" data-aos="fade-up">

        <div class="section-title">
            <h2>Menu</h2>
            <p>Check Our Delicious Menu</p>
        </div>

        <div class="mb-3 text-end">
            <a asp-action="Create" class="btn btn-primary">+ Add New Dish</a>
        </div>

        <div class="row gy-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="menu-item d-flex align-items-start p-3 border rounded shadow-sm h-100">
                        <img src="@item.ImageUrl" class="img-fluid rounded" style="width: 100px; height: 100px; object-fit: cover; margin-right: 15px;" alt="@item.Name" />
                        <div>
                            <h5>@item.Name</h5>
                            <p class="text-muted">@item.Description</p>
                            <strong class="text-danger">@item.Price.ToString("C")</strong>
                            <div class="mt-2">
                                <a asp-action="Edit" asp-route-id="@item.MenuItemId" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.MenuItemId" class="btn btn-sm btn-outline-secondary me-1">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.MenuItemId"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure you want to delete this item?');">Delete</a>

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>
