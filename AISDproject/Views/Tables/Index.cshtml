@model IEnumerable<AISDproject.Models.Table>
@using AISDproject.Models

@{
    ViewData["Title"] = "Tables";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <!-- Title + Add Button -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">Manage Restaurant Tables</h2>
            <a asp-action="Create" class="btn btn-danger rounded-pill shadow px-4 py-2">
                <i class="bi bi-plus-circle me-1"></i> Add New Table
            </a>
        </div>


        <!-- Table -->
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="text-center bg-light">
                            <tr>
                                <th>Table Name</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        <i class="bi bi-exclamation-circle-fill me-2"></i> No tables available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.TableName</td>
                                        <td class="text-center">@item.Capacity</td>
                                        <td class="text-center">
                                            @if (item.Status == Table.TableStatus.Available)
                                            {
                                                <span class="badge bg-success px-3 py-2">Available</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">Unavailable</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a asp-action="Edit" asp-route-id="@item.TableId"
                                                   class="btn btn-sm btn-outline-primary rounded-circle"
                                                   title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.TableId"
                                                   class="btn btn-sm btn-outline-success rounded-circle"
                                                   title="Details">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.TableId"
                                                   class="btn btn-sm btn-outline-danger rounded-circle"
                                                   title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>

                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
