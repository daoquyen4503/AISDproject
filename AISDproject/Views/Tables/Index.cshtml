@model IEnumerable<AISDproject.Models.Table>

@{
    ViewData["Title"] = "Tables";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">
                Manage Restaurant Tables
            </h2>
        </div>

        <!-- Search + Add button -->
        <div class="row align-items-center mb-4">
            <div class="col-md-6">
                <form asp-action="Index" method="get" class="d-flex">
                    <input type="text" name="searchString" class="form-control rounded-pill me-2" placeholder="🔍 Search table name..." />
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" class="btn btn-danger rounded-pill shadow px-4 py-2">
                    <i class="bi bi-plus-circle me-1"></i> Add New Table
                </a>
            </div>
        </div>

        <!-- Table -->
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-danger text-center">
                            <tr>
                                <th style="width: 40%">Table Name</th>
                                <th style="width: 20%">Capacity</th>
                                <th style="width: 40%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        <i class="bi bi-exclamation-circle-fill me-2"></i> No tables available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">@Html.DisplayFor(modelItem => item.TableName)</td>
                                        <td class="text-center">@Html.DisplayFor(modelItem => item.Capacity)</td>
                                        <td class="text-center">
                                            <a asp-action="Edit" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-primary rounded-pill me-1">
                                                <i class="bi bi-pencil-square"></i> Edit
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-success rounded-pill me-1">
                                                <i class="bi bi-info-circle"></i> Details
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="bi bi-trash"></i> Delete
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
