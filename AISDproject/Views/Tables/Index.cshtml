@model IEnumerable<AISDproject.Models.Table>
@using AISDproject.Models

@{
    ViewData["Title"] = "Tables";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #1d3557;
    }

    .btn-danger-custom {
        background-color: #c92a2a;
        border-color: #c92a2a;
        color: white;
        font-weight: 500;
        padding: 8px 24px;
        font-size: 14px;
    }

        .btn-danger-custom:hover {
            background-color: #a61e1e;
            border-color: #a61e1e;
        }

    .action-btns .btn {
        padding: 4px 10px;
        font-size: 13px;
    }

    .badge-status {
        font-size: 13px;
        padding: 6px 14px;
    }
</style>

<section class="py-4">
    <div class="container">

        <!-- Title and Add -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">Manage Restaurant Tables</h2>
            <a asp-action="Create" class="btn btn-danger-custom rounded-pill shadow">
                Add New Table
            </a>
        </div>

        <!-- Table listing -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="text-center table-light">
                            <tr>
                                <th>Table Name</th>
                                <th>Capacity</th>
                                <th>Status</th>
                                <th style="width: 160px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        No tables found.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr class="text-center">
                                        <td class="fw-semibold">@item.TableName</td>
                                        <td>@item.Capacity</td>
                                        <td>
                                            @if (item.Status == Table.TableStatus.Available)
                                            {
                                                <span class="badge bg-success badge-status">Available</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary badge-status">Unavailable</span>
                                            }
                                        </td>
                                        <td class="action-btns">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a asp-action="Edit" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-primary rounded-pill">
                                                    Edit
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-secondary rounded-pill">
                                                    Details
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-danger rounded-pill">
                                                    Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>
