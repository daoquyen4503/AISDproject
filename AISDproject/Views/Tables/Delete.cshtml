@model AISDproject.Models.Table

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<h1>Delete Table</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.TableId</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.TableName</dd>

        <dt class="col-sm-2">Capacity</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="TableId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
