@model IEnumerable<AISDproject.ViewModels.OrderDetailViewModel>

@{
    ViewData["Title"] = "Orders";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-dark mb-0">Manage Orders</h2>
            <a asp-action="Create" class="btn btn-danger rounded-pill shadow px-4">
                Create New Order
            </a>
        </div>

        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="text-center text-white" style="background-color: #1d3557;">
                            <tr>
                                <th>Order ID</th>
                                <th>Table</th>
                                <th>Staff</th>
                                <th>Order Time</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th style="width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr class="text-center align-middle @(order.PaymentStatus == AISDproject.Models.PaymentStatus.Paid ? "" : "table-warning")">
                                    <td>@order.OrderId</td>
                                    <td>@order.TableName</td>
                                    <td>@order.StaffName</td>
                                    <td>@order.OrderTime.ToString("g")</td>
                                    <td>@order.TotalAmount.ToString("N0") đ</td>
                                    <td>@order.Status</td>
                                    <td>
                                        @switch (order.PaymentStatus)
                                        {
                                            case AISDproject.Models.PaymentStatus.Paid:
                                                <span class="badge bg-success">Paid</span>
                                                break;
                                            case AISDproject.Models.PaymentStatus.Pending:
                                                <span class="badge bg-danger">Unpaid</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Unknown</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary rounded-circle" title="Edit">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-success rounded-circle" title="Details">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                            @if (order.PaymentStatus == AISDproject.Models.PaymentStatus.Pending)
                                            {
                                                <a asp-action="Checkout" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-warning rounded-circle" title="Checkout">
                                                    <i class="bi bi-cash-coin"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    .table tbody tr:hover {
        background-color: #f1f3f5 !important;
        transition: background-color 0.3s ease;
    }

    .table-warning {
        background-color: #fff3cd !important;
    }
</style>

