@model AISDproject.ViewModels.OrderCreateViewModel

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Create Order";

    // JSON for JS price lookup
    var menuPricesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.MenuItems.ToDictionary(m => m.MenuItemId, m => m.Price)
    );
}

<style>
    h2 {
        text-align: center;
        margin-bottom: 30px;
        font-weight: bold;
        color: #1d3557;
    }

    #itemsTable th {
        background-color: #1d3557;
        color: white;
    }

    #itemsTable td, #itemsTable th {
        text-align: center;
        vertical-align: middle;
    }

    .btn {
        border-radius: 20px;
    }

    .total-box {
        font-weight: bold;
        font-size: 1.2em;
        color: #1d3557;
    }
</style>


<h2>@ViewData["Title"]</h2>

<div class="container">
    <form asp-controller="Orders" asp-action="Create" method="post" class="card shadow p-4 border-0 bg-light rounded-4">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="TableId" class="form-label fw-semibold">🪑 Table</label>
                <select asp-for="TableId" asp-items="Model.TableList" class="form-control rounded-pill">
                    <option value="">-- Select table --</option>
                </select>
                <span asp-validation-for="TableId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StaffId" class="form-label fw-semibold">👨‍🍳 Staff</label>
                <select asp-for="StaffId" asp-items="Model.StaffList" class="form-control rounded-pill">
                    <option value="">-- Select staff --</option>
                </select>
                <span asp-validation-for="StaffId" class="text-danger"></span>
            </div>
        </div>

        <h5 class="text-primary fw-bold">Menu Items</h5>
        <div class="table-responsive">
            <table class="table table-bordered mt-2" id="itemsTable">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Unit Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Rows will be added by JS -->
                </tbody>
            </table>
        </div>

        <button type="button" class="btn btn-outline-primary rounded-pill my-2" id="add-item">+ Add Item</button>

        <div class="text-end mt-3 total-box">
            Total: <span id="total-amount">0</span> ₫
            <input type="hidden" asp-for="TotalAmount" id="TotalAmount" />
        </div>

        <div class="text-end mt-4">
            <button type="submit" class="btn btn-danger rounded-pill px-4 me-2">💾 Create Order</button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">❌ Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const menuPrices = @Html.Raw(menuPricesJson);
        let itemIndex = 0;

        function addItemRow(menuItemId = "", quantity = 1) {
            const tbody = document.querySelector("#itemsTable tbody");
            const tr = document.createElement("tr");

            tr.innerHTML = `
                <td>
                    <select name="Items[${itemIndex}].MenuItemId" class="form-control menu-select" data-index="${itemIndex}">
                        <option value="">-- Select item --</option>
        @foreach (var opt in Model.MenuItemList)
        {
                                    <option value="@opt.Value">@opt.Text</option>
        }
                    </select>
                </td>
                <td><span class="price" data-index="${itemIndex}">0</span></td>
                <td>
                    <input name="Items[${itemIndex}].Quantity" type="number" min="1" class="form-control quantity-input text-center" data-index="${itemIndex}" value="${quantity}" />
                </td>
                <td><span class="line-total" data-index="${itemIndex}">0</span></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="this.closest('tr').remove(); calculateTotal();">✕</button></td>
            `;

            tbody.appendChild(tr);

            if (menuItemId) {
                tr.querySelector(`select[data-index="${itemIndex}"]`).value = menuItemId;
            }

            tr.querySelector(`select[data-index="${itemIndex}"]`).addEventListener("change", updateRow);
            tr.querySelector(`input[data-index="${itemIndex}"]`).addEventListener("input", updateRow);

            updateRow({ target: tr.querySelector(`select[data-index="${itemIndex}"]`) });
            itemIndex++;
        }

        function updateRow(e) {
            const index = e.target.dataset.index;
            const menuId = document.querySelector(`select[data-index="${index}"]`).value;
            const qty = parseInt(document.querySelector(`input[data-index="${index}"]`).value) || 0;
            const price = menuPrices[menuId] || 0;

            document.querySelector(`.price[data-index="${index}"]`).innerText = price.toFixed(0);
            document.querySelector(`.line-total[data-index="${index}"]`).innerText = (price * qty).toFixed(0);

            calculateTotal();
        }

        function calculateTotal() {
            let total = 0;
            document.querySelectorAll(".line-total").forEach(span => {
                total += parseFloat(span.innerText) || 0;
            });
            document.getElementById("total-amount").innerText = total.toFixed(0);
            document.getElementById("TotalAmount").value = total;
        }

        document.getElementById("add-item").addEventListener("click", () => addItemRow());

        addItemRow();
    </script>
}
