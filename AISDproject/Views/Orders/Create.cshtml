@model AISDproject.ViewModels.OrderCreateViewModel

@{
    ViewData["Title"] = "Create Order";

    var menuItemsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.MenuItems?.ToDictionary(m => m.MenuItemId, m => m.Price) ?? new Dictionary<int, decimal>()
    );

    var menuOptionsHtml = string.Join("", Model.MenuItemList.Select(item =>
        $"<option value='{item.Value}'>{item.Text}</option>"));
}

<h1>Create Order</h1>

<form asp-action="Create" method="post">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <label asp-for="TableId" class="control-label"></label>
        <select asp-for="TableId" asp-items="Model.TableList" class="form-control"></select>
        <span asp-validation-for="TableId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="StaffId" class="control-label"></label>
        <select asp-for="StaffId" asp-items="Model.StaffList" class="form-control"></select>
        <span asp-validation-for="StaffId" class="text-danger"></span>
    </div>

    <h4>Order Items</h4>

    <table class="table" id="itemsTable">
        <thead>
            <tr>
                <th>Menu Item</th>
                <th>Quantity</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="Items[@i].MenuItemId" asp-items="Model.MenuItemList" class="form-control item-select"></select>
                        <span asp-validation-for="Items[@i].MenuItemId" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="Items[@i].Quantity" class="form-control qty-input" />
                        <span asp-validation-for="Items[@i].Quantity" class="text-danger"></span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addRow()">+ Add Item</button>

    <div class="mt-3">
        <strong>Tổng tiền: </strong><span id="total-amount">0</span> ₫
        <input type="hidden" name="TotalAmount" id="TotalAmount" value="0" />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Create Order</button>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script>
        const prices = @Html.Raw(menuItemsJson);
        const menuOptions = `@Html.Raw(menuOptionsHtml)`;

        function updateTotal() {
            let total = 0;
            document.querySelectorAll("#itemsTable tbody tr").forEach(row => {
                const menuItemId = row.querySelector(".item-select").value;
                const qty = parseInt(row.querySelector(".qty-input").value) || 0;
                const price = prices[menuItemId] || 0;
                total += price * qty;
            });
            document.getElementById("total-amount").textContent = total.toLocaleString();
            document.getElementById("TotalAmount").value = total;
        }

        function addRow() {
            const index = document.querySelectorAll("#itemsTable tbody tr").length;
            const row = `
                <tr>
                    <td>
                        <select name="Items[${index}].MenuItemId" class="form-control item-select">
                            ${menuOptions}
                        </select>
                        <span class="text-danger field-validation-valid" data-valmsg-for="Items[${index}].MenuItemId" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input name="Items[${index}].Quantity" class="form-control qty-input" value="1" />
                        <span class="text-danger field-validation-valid" data-valmsg-for="Items[${index}].Quantity" data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger" onclick="removeRow(this)">X</button>
                    </td>
                </tr>`;
            document.querySelector("#itemsTable tbody").insertAdjacentHTML("beforeend", row);
            updateTotal();
        }

        function removeRow(btn) {
            btn.closest("tr").remove();
            updateTotal();
        }

        document.addEventListener("input", function (e) {
            if (e.target.classList.contains("item-select") || e.target.classList.contains("qty-input")) {
                updateTotal();
            }
        });

        document.addEventListener("DOMContentLoaded", updateTotal);
    </script>
}
