@model AISDproject.ViewModels.OrderCreateViewModel

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Tạo đơn hàng";

    var menuPricesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.MenuItems.ToDictionary(m => m.MenuItemId, m => m.Price)
    );
    var menuOptionsHtml = string.Join("",
        Model.MenuItemList.Select(m => $"<option value='{m.Value}'>{m.Text}</option>"));
}

<style>
    h2 {
        text-align: center;
        margin-bottom: 30px;
        font-weight: bold;
        color: #d63384;
    }

    .form-group label {
        font-weight: 500;
    }

    #itemsTable {
        border-radius: 8px;
        overflow: hidden;
    }

        #itemsTable th {
            background-color: #ffc107;
            text-align: center;
        }

        #itemsTable td {
            vertical-align: middle;
            text-align: center;
        }

    .btn-danger, .btn-secondary, .btn-primary {
        border-radius: 20px;
    }

    .table-hover tbody tr:hover {
        background-color: #fff3cd;
    }

    .total-box {
        font-size: 18px;
        font-weight: bold;
        color: #0d6efd;
    }

    .text-danger {
        font-size: 0.9em;
    }
</style>


<h2>@ViewData["Title"]</h2>

<form asp-controller="Orders" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <section class="section-bg py-5">
        <div class="container" data-aos="fade-up">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-danger mb-0">📝 Tạo Đơn Hàng Mới</h2>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">← Quay lại</a>
            </div>

            <form asp-controller="Orders" asp-action="Create" method="post" class="card shadow p-4 rounded-4 border-0 bg-light">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="TableId" class="form-label fw-semibold">🪑 Bàn</label>
                        <select asp-for="TableId" asp-items="Model.TableList" class="form-control rounded-pill">
                            <option value="">-- Chọn bàn --</option>
                        </select>
                        <span asp-validation-for="TableId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StaffId" class="form-label fw-semibold">👨‍🍳 Nhân viên</label>
                        <select asp-for="StaffId" asp-items="Model.StaffList" class="form-control rounded-pill">
                            <option value="">-- Chọn nhân viên --</option>
                        </select>
                        <span asp-validation-for="StaffId" class="text-danger"></span>
                    </div>
                </div>

                <h5 class="mt-4 text-primary fw-bold">Menu</h5>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mt-2" id="itemsTable">
                        <thead class="table-warning text-center">
                            <tr>
                                <th>Món ăn</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr class="text-center">
                                    <td>
                                        <select name="Items[@i].MenuItemId" class="form-control menu-select" data-index="@i">
                                            <option value="">-- Chọn món --</option>
                                            @foreach (var opt in Model.MenuItemList)
                                            {
                                                <option value="@opt.Value" selected="@(opt.Value == Model.Items[i].MenuItemId.ToString() ? "selected" : null)">
                                                    @opt.Text
                                                </option>
                                            }
                                        </select>
                                        <span asp-validation-for="Items[@i].MenuItemId" class="text-danger"></span>
                                    </td>
                                    <td><span class="price" data-index="@i">0</span></td>
                                    <td>
                                        <input name="Items[@i].Quantity" type="number" min="1" class="form-control quantity-input text-center" data-index="@i" value="@Model.Items[i].Quantity" />
                                        <span asp-validation-for="Items[@i].Quantity" class="text-danger"></span>
                                    </td>
                                    <td><span class="line-total" data-index="@i">0</span></td>
                                    <td><button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="removeRow(this)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="button" class="btn btn-outline-primary rounded-pill my-2" id="add-item">+ Thêm món</button>

                <div class="mt-3 fs-5 fw-bold text-end text-primary">
                    Tổng cộng: <span id="total-amount">0</span> ₫
                    <input type="hidden" asp-for="TotalAmount" id="TotalAmount" />
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 me-2">💾 Tạo đơn</button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">❌ Hủy</a>
                </div>
            </form>
        </div>
    </section>
</form>

