@model AISDproject.ViewModels.OrderEditViewModel
@{
    var menuPricesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.MenuItems.ToDictionary(m => m.MenuItemId, m => m.Price)
    );
    ViewData["Title"] = "Edit Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">✏️ Edit Order #@Model.OrderId</h2>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">← Back</a>
        </div>

        <form asp-action="Edit" method="post" class="card shadow p-4 rounded-4 border-0">
            <input type="hidden" asp-for="OrderId" />
            <input type="hidden" asp-for="TotalAmount" /> <!-- ✅ Thêm dòng này -->

            <div class="mb-3">
                <label asp-for="TableId" class="form-label fw-semibold">Table</label>
                <select asp-for="TableId" class="form-control rounded-pill" asp-items="Model.TableList"></select>
            </div>

            <div class="mb-3">
                <label asp-for="StaffId" class="form-label fw-semibold">Staff</label>
                <select asp-for="StaffId" class="form-control rounded-pill" asp-items="Model.StaffList"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                <select asp-for="Status" class="form-control rounded-pill">
                    @foreach (var status in Enum.GetValues(typeof(AISDproject.Models.OrderStatus)))
                    {
                        <option value="@status" selected="@(Model.Status == (AISDproject.Models.OrderStatus)status)">@status</option>
                    }
                </select>
            </div>

            <h5 class="mt-4">🧾 Items</h5>
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th>Dish</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var price = Model.MenuItems.FirstOrDefault(m => m.MenuItemId == Model.Items[i].MenuItemId)?.Price ?? 0;
                            <tr class="text-center">
                                <td>
                                    <select asp-for="Items[@i].MenuItemId" class="form-control" asp-items="Model.MenuItemList"></select>
                                </td>
                                <td>@price.ToString("N0") đ</td>
                                <td><input asp-for="Items[@i].Quantity" class="form-control text-center" /></td>
                                <td>@((price * Model.Items[i].Quantity).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end"><strong>Total:</strong></td>
                            <td><strong id="total-display">@Model.TotalAmount.ToString("N0") đ</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-danger rounded-pill px-4">💾 Save</button>
            </div>
        </form>

        <script>
            const menuPrices = @Html.Raw(menuPricesJson);

            function updateTotals() {
                let total = 0;
                const rows = document.querySelectorAll("tbody tr");

                rows.forEach((row, index) => {
                    const select = row.querySelector(`select[name="Items[${index}].MenuItemId"]`);
                    const qtyInput = row.querySelector(`input[name="Items[${index}].Quantity"]`);
                    const priceCell = row.children[1];
                    const subtotalCell = row.children[3];

                    const menuItemId = select.value;
                    const quantity = parseInt(qtyInput.value) || 0;
                    const price = menuPrices[menuItemId] || 0;
                    const subtotal = price * quantity;

                    priceCell.textContent = price.toLocaleString() + " đ";
                    subtotalCell.textContent = subtotal.toLocaleString() + " đ";

                    total += subtotal;
                });

                document.getElementById("total-display").textContent = total.toLocaleString() + " đ";
                document.querySelector("input[name='TotalAmount']").value = total;
            }

            window.addEventListener('DOMContentLoaded', function () {
                updateTotals();

                document.querySelectorAll("select, input[type='number'], input[type='text']").forEach(input => {
                    input.addEventListener("change", updateTotals);
                });
            });
        </script>

    </div>
</section>
