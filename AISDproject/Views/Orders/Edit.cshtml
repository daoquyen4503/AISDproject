@model AISDproject.ViewModels.OrderEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa đơn hàng";
}

<h2>Chỉnh sửa đơn hàng #@Model.OrderId</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="OrderId" />
    <div class="form-group">
        <label asp-for="TableId"></label>
        <select asp-for="TableId" class="form-control" asp-items="Model.TableList"></select>
    </div>
    <div class="form-group">
        <label asp-for="StaffId"></label>
        <select asp-for="StaffId" class="form-control" asp-items="Model.StaffList"></select>
    </div>
    <div class="form-group">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            @foreach (var status in Enum.GetValues(typeof(AISDproject.Models.OrderStatus)))
            {
                <option value="@status" selected="@(Model.Status == (AISDproject.Models.OrderStatus)status)">@status</option>
            }
        </select>
    </div>

    <h4>Món ăn</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Món</th>
                <th>Đơn giá</th>
                <th>Số lượng</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                var price = Model.MenuItems.FirstOrDefault(m => m.MenuItemId == Model.Items[i].MenuItemId)?.Price ?? 0;
                <tr>
                    <td>
                        <select asp-for="Items[@i].MenuItemId" class="form-control" asp-items="Model.MenuItemList"></select>
                    </td>
                    <td>@price.ToString("N0") đ</td>
                    <td><input asp-for="Items[@i].Quantity" class="form-control" /></td>
                    <td>@(price * Model.Items[i].Quantity).ToString("N0") đ</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
                <td><strong>@Model.TotalAmount.ToString("N0") đ</strong></td>
            </tr>
        </tfoot>
    </table>


    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>