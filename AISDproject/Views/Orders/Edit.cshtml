@model AISDproject.ViewModels.OrderEditViewModel
@{
    var menuPricesJson = System.Text.Json.JsonSerializer.Serialize(
        Model.MenuItems.ToDictionary(m => m.MenuItemId, m => m.Price)
    );
    ViewData["Title"] = "Edit Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #1d3557;
    }

    .table th, .table td {
        vertical-align: middle !important;
        text-align: center;
    }

    .btn {
        border-radius: 20px;
    }

    .table thead {
        background-color: #1d3557;
        color: #fff;
    }

    .total-row {
        font-weight: bold;
        font-size: 1.1rem;
        color: #1d3557;
    }
</style>

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">Edit Order #@Model.OrderId</h2>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                Back
            </a>
        </div>

        <form asp-action="Edit" method="post" class="card shadow p-4 rounded-4 border-0">
            <input type="hidden" asp-for="OrderId" />
            <input type="hidden" asp-for="TotalAmount" />

            <div class="mb-3">
                <label asp-for="TableId" class="form-label fw-semibold">Table</label>
                <select asp-for="TableId" class="form-control rounded-pill" asp-items="Model.TableList"></select>
            </div>

            <div class="mb-3">
                <label asp-for="StaffId" class="form-label fw-semibold">Staff</label>
                <select asp-for="StaffId" class="form-control rounded-pill" asp-items="Model.StaffList"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                <select asp-for="Status" class="form-control rounded-pill">
                    @foreach (var status in Enum.GetValues(typeof(AISDproject.Models.OrderStatus)))
                    {
                        <option value="@status" selected="@(Model.Status == (AISDproject.Models.OrderStatus)status)">@status</option>
                    }
                </select>
            </div>

            <h5 class="fw-bold text-primary mt-4 mb-3">Order Items</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>Dish</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td>
                                    <select asp-for="Items[@i].MenuItemId" class="form-control menu-select" data-index="@i" asp-items="Model.MenuItemList"></select>
                                </td>
                                <td><span class="price" data-index="@i">0</span></td>
                                <td><input asp-for="Items[@i].Quantity" class="form-control quantity-input text-center" data-index="@i" /></td>
                                <td><span class="line-total" data-index="@i">0</span></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end total-row">Total:</td>
                            <td class="total-row"><span id="total-display">0</span> ₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-success rounded-pill px-4">Save</button>
            </div>
        </form>

        <script>
            const menuPrices = @Html.Raw(menuPricesJson);

            function updateTotals() {
                let total = 0;
                const rows = document.querySelectorAll("tbody tr");

                rows.forEach((row, index) => {
                    const menuId = row.querySelector(`select[data-index="${index}"]`).value;
                    const qty = parseInt(row.querySelector(`input[data-index="${index}"]`).value) || 0;
                    const price = menuPrices[menuId] || 0;
                    const subtotal = price * qty;

                    row.querySelector(`.price[data-index="${index}"]`).textContent = price.toLocaleString();
                    row.querySelector(`.line-total[data-index="${index}"]`).textContent = subtotal.toLocaleString();

                    total += subtotal;
                });

                document.getElementById("total-display").textContent = total.toLocaleString();
                document.querySelector("input[name='TotalAmount']").value = total;
            }

            window.addEventListener('DOMContentLoaded', function () {
                updateTotals();
                document.querySelectorAll("select, input[type='number'], input[type='text']").forEach(input => {
                    input.addEventListener("change", updateTotals);
                });
            });
        </script>
    </div>
</section>
