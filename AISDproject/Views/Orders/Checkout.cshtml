@model AISDproject.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Order Checkout";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body p-5">

                <h2 class="fw-bold text-success mb-4 text-center">
                    <i class="bi bi-cash-stack me-2"></i> Order Checkout
                </h2>

                <div class="mb-4 text-center">
                    <p class="mb-1">
                        <span class="fw-semibold">Order ID:</span>
                        <span class="text-dark">#@ViewBag.OrderId</span>
                    </p>
                    <p class="mb-1">
                        <span class="fw-semibold">Table:</span>
                        <span class="text-primary">@ViewBag.TableName</span>
                    </p>
                    <p class="mb-0">
                        <span class="fw-semibold">Total Amount:</span>
                        <span class="text-danger fw-bold fs-5">@(((decimal)ViewBag.TotalAmount).ToString("N0")) đ</span>
                    </p>
                </div>

                <form asp-action="Checkout" method="post" class="px-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OrderId" />

                    <div class="mb-4">
                        <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method</label>
                        <select asp-for="PaymentMethod" class="form-select rounded-pill">
                            <option value="">-- Select Payment Method --</option>
                            @foreach (var method in Enum.GetValues(typeof(AISDproject.Models.PaymentMethod)))
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success rounded-pill px-4">
                            <i class="bi bi-check-circle me-1"></i> Confirm Payment
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
