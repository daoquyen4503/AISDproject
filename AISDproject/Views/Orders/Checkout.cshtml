@model AISDproject.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Order Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body p-5">

                <h2 class="fw-bold text-success mb-4">
                    <i class="bi bi-cash-stack me-2"></i> Checkout Order #@ViewBag.OrderId
                </h2>

                <p class="mb-2"><strong>Table:</strong> <span class="text-primary">@ViewBag.TableName</span></p>
                <p class="mb-4"><strong>Total Amount:</strong> <span class="text-danger fw-bold">@(((decimal)ViewBag.TotalAmount).ToString("N0")) đ</span></p>

                <form asp-action="Checkout" method="post">
                    <input type="hidden" asp-for="OrderId" />

                    <!-- Payment method -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold">Payment Method</label>
                        <select asp-for="PaymentMethod" class="form-control">
                            <option value="">-- Select Payment Method --</option>
                            @foreach (var method in Enum.GetValues(typeof(AISDproject.Models.PaymentMethod)))
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                        <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success rounded-pill px-4">
                            <i class="bi bi-check-circle me-1"></i> Confirm Payment
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
