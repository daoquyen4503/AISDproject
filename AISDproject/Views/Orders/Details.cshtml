<h1>Chi tiết đơn hàng</h1>

<div class="mb-3">
    <h4 class="text-primary">Thông tin đơn hàng</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Mã đơn</dt>
        <dd class="col-sm-10">@Model.OrderId</dd>

        <dt class="col-sm-2">Bàn</dt>
        <dd class="col-sm-10">@Model.TableName</dd>

        <dt class="col-sm-2">Nhân viên</dt>
        <dd class="col-sm-10">@Model.StaffName</dd>

        <dt class="col-sm-2">Thời gian</dt>
        <dd class="col-sm-10">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-2">Tổng tiền</dt>
        <dd class="col-sm-10"><strong>@Model.TotalAmount.ToString("N0") đ</strong></dd>

        <dt class="col-sm-2">Trạng thái</dt>
        <dd class="col-sm-10">@Model.Status</dd>
    </dl>
</div>

<h4 class="text-primary">Chi tiết món ăn</h4>
<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Tên món</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.MenuItemName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@item.LineTotal.ToString("N0") đ</td>
            </tr>
        }
    </tbody>
    <tfoot class="table-light">
        <tr>
            <td colspan="3" class="text-end"><strong>Tổng cộng:</strong></td>
            <td><strong>@Model.TotalAmount.ToString("N0") đ</strong></td>
        </tr>
    </tfoot>
</table>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-warning">Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>

    @if (Model.PaymentStatus != AISDproject.Models.PaymentStatus.Paid)
    {
        <a asp-action="Checkout" asp-route-id="@Model.OrderId" class="btn btn-success">Thanh toán</a>
    }
    else
    {
        <span class="badge bg-success">Đã thanh toán</span>
    }
</div>
