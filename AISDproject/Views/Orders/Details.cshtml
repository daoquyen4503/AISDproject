@model AISDproject.ViewModels.OrderDetailViewModel

@{
    ViewData["Title"] = "Order Details";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">Order Details #@Model.OrderId</h2>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to List</a>
            </div>
        </div>

        <div class="card shadow-sm p-4 rounded-4 mb-4">
            <h5 class="text-primary fw-bold mb-3">Order Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Table</dt>
                <dd class="col-sm-9">@Model.TableName</dd>

                <dt class="col-sm-3">Staff</dt>
                <dd class="col-sm-9">@Model.StaffName</dd>

                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">@Model.OrderTime.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Total</dt>
                <dd class="col-sm-9 text-danger fw-bold">@Model.TotalAmount.ToString("N0") ₫</dd>

                <dt class="col-sm-3">Payment</dt>
                <dd class="col-sm-9">
                    @switch (Model.PaymentStatus)
                    {
                        case AISDproject.Models.PaymentStatus.Paid:
                            <span class="badge bg-success">Paid</span>
                            break;
                        case AISDproject.Models.PaymentStatus.Pending:
                            <span class="badge bg-danger">Unpaid</span>
                            break;
                        default:
                            <span class="badge bg-secondary">Unknown</span>
                            break;
                    }
                </dd>
            </dl>
        </div>

        <div class="card shadow-sm p-4 rounded-4">
            <h5 class="text-primary fw-bold mb-3">Ordered Dishes</h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr class="text-center">
                            <th>Dish</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="text-center">
                                <td>@item.MenuItemName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("N0") ₫</td>
                                <td>@item.LineTotal.ToString("N0") ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total:</td>
                            <td class="fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="mt-4 text-end">
            <a asp-action="Edit" asp-route-id="@Model.OrderId" class="btn btn-warning rounded-pill px-3 me-2">
                Edit
            </a>

            @if (Model.PaymentStatus != AISDproject.Models.PaymentStatus.Paid)
            {
                <a asp-action="Checkout" asp-route-id="@Model.OrderId" class="btn btn-success rounded-pill px-3">
                    Checkout
                </a>
            }
        </div>

    </div>
</section>
