@model AISDproject.Models.OrderItem

@{
    ViewData["Title"] = "Edit OrderItem";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<h2>Edit</h2>

<h4>OrderItem</h4>
<hr />

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="OrderId" class="control-label"></label>
        <select asp-for="OrderId" class="form-control" asp-items="ViewBag.OrderId"></select>
        <span asp-validation-for="OrderId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="MenuItemId" class="control-label"></label>
        <select asp-for="MenuItemId" class="form-control" asp-items="ViewBag.MenuItemId" id="menuItemSelect"></select>
        <span asp-validation-for="MenuItemId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quantity" class="control-label"></label>
        <input asp-for="Quantity" class="form-control" id="quantityInput" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Subtotal</label>
        <input type="text" class="form-control" id="subtotalDisplay" readonly />
    </div>

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-link">Back to List</a>
    </div>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const menuPrices = {
        @foreach (var item in (IEnumerable<AISDproject.Models.MenuItem>)ViewBag.MenuItems)
        {
            @:$"{item.MenuItemId}: {item.Price},"
        }
        };

        function calculateSubtotal() {
            const menuItemId = parseInt(document.getElementById('menuItemSelect').value);
            const quantity = parseInt(document.getElementById('quantityInput').value) || 0;
            const price = menuPrices[menuItemId] || 0;
            document.getElementById('subtotalDisplay').value = (price * quantity).toFixed(2);
        }

        document.getElementById('menuItemSelect').addEventListener('change', calculateSubtotal);
        document.getElementById('quantityInput').addEventListener('input', calculateSubtotal);

        // Gọi lần đầu khi load form
        calculateSubtotal();
    </script>
}
