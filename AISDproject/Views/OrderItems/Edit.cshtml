@model AISDproject.Models.OrderItem

@{
    ViewData["Title"] = "Edit Order Item";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold text-danger mb-4">
                    <i class="bi bi-pencil-square me-2"></i> Edit Order Item
                </h2>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Order -->
                    <div class="form-group mb-3">
                        <label asp-for="OrderId" class="form-label fw-semibold">Order</label>
                        <select asp-for="OrderId" class="form-control rounded-pill" asp-items="ViewBag.OrderId"></select>
                        <span asp-validation-for="OrderId" class="text-danger small"></span>
                    </div>

                    <!-- MenuItem -->
                    <div class="form-group mb-3">
                        <label asp-for="MenuItemId" class="form-label fw-semibold">Menu Item</label>
                        <select asp-for="MenuItemId" class="form-control rounded-pill" asp-items="ViewBag.MenuItemId" id="menuItemSelect"></select>
                        <span asp-validation-for="MenuItemId" class="text-danger small"></span>
                    </div>

                    <!-- Quantity -->
                    <div class="form-group mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <input asp-for="Quantity" class="form-control rounded-pill" id="quantityInput" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <!-- Subtotal -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold">Subtotal</label>
                        <input type="text" class="form-control bg-light rounded-pill text-end" id="subtotalDisplay" readonly />
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-arrow-left-circle me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-save me-1"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const menuPrices = {
        @foreach (var item in (IEnumerable<AISDproject.Models.MenuItem>)ViewBag.MenuItems)
        {
            @:$"{item.MenuItemId}: {item.Price},"
        }
        };

        function animateSubtotal(newTotal) {
            const display = document.getElementById('subtotalDisplay');
            display.style.transition = 'background-color 0.3s ease-in-out';
            display.style.backgroundColor = '#fff3cd'; // light yellow
            setTimeout(() => {
                display.style.backgroundColor = '#f8f9fa'; // back to neutral
            }, 300);
            display.value = newTotal.toLocaleString('en-US', {
                style: 'currency',
                currency: 'USD'
            });
        }

        function calculateSubtotal() {
            const menuItemId = parseInt(document.getElementById('menuItemSelect').value);
            const quantity = parseInt(document.getElementById('quantityInput').value) || 0;
            const price = menuPrices[menuItemId] || 0;
            animateSubtotal(price * quantity);
        }

        document.getElementById('menuItemSelect').addEventListener('change', calculateSubtotal);
        document.getElementById('quantityInput').addEventListener('input', calculateSubtotal);
        calculateSubtotal();
    </script>
}
