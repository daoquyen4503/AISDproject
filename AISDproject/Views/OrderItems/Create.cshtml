@model AISDproject.Models.OrderItem

@{
    ViewData["Title"] = "Create Order Item";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    var menuItems = (IEnumerable<AISDproject.Models.MenuItem>)ViewBag.MenuItems;
}

<style>
    .fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }
        opacity: 0.2;
    }

    to {
        opacity: 1;
    }

    }

    .dish-image-preview {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        display: none;
        margin-top: 10px;
    }
</style>

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold text-danger mb-4">
                    <i class="bi bi-plus-circle me-2"></i> Create Order Item
                </h2>

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Order -->
                    <div class="form-group mb-3">
                        <label asp-for="OrderId" class="form-label fw-semibold">Order</label>
                        <select asp-for="OrderId" class="form-control" asp-items="ViewBag.OrderId"></select>
                        <span asp-validation-for="OrderId" class="text-danger small"></span>
                    </div>

                    <!-- MenuItem -->
                    <div class="form-group mb-3">
                        <label asp-for="MenuItemId" class="form-label fw-semibold">Menu Item</label>
                        <select asp-for="MenuItemId" class="form-control" id="menuItemSelect">
                            <option value="">-- Select Dish --</option>
                            @foreach (var item in menuItems)
                            {
                                <option value="@item.MenuItemId"
                                        data-price="@item.Price"
                                        data-img="@item.ImageUrl">
                                    🍽️ @item.Name
                                </option>
                            }
                        </select>
                        <span asp-validation-for="MenuItemId" class="text-danger small"></span>

                        <img id="dishImagePreview" class="dish-image-preview" src="#" alt="Dish Preview" />
                    </div>

                    <!-- Quantity -->
                    <div class="form-group mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <input asp-for="Quantity" class="form-control" id="quantityInput" />
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>

                    <!-- Subtotal -->
                    <div class="form-group mb-4">
                        <label class="form-label fw-semibold">Subtotal</label>
                        <input type="text" class="form-control bg-light text-end rounded-pill" id="subtotalDisplay" readonly />
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-arrow-left-circle me-1"></i> Back
                        </a>
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-plus-circle me-1"></i> Create
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        const select = document.getElementById('menuItemSelect');
        const qtyInput = document.getElementById('quantityInput');
        const subtotalDisplay = document.getElementById('subtotalDisplay');
        const imagePreview = document.getElementById('dishImagePreview');

        function calculateSubtotal() {
            const selected = select.options[select.selectedIndex];
            const price = parseFloat(selected.dataset.price || 0);
            const quantity = parseInt(qtyInput.value) || 0;
            const subtotal = price * quantity;

            subtotalDisplay.classList.add("fade-in");
            subtotalDisplay.value = subtotal.toLocaleString('en-US', {
                style: 'currency',
                currency: 'USD'
            });

            setTimeout(() => subtotalDisplay.classList.remove("fade-in"), 300);
        }

        function updateDishImage() {
            const selected = select.options[select.selectedIndex];
            const imgSrc = selected.dataset.img;

            if (imgSrc) {
                imagePreview.src = imgSrc;
                imagePreview.style.display = 'block';
                imagePreview.classList.add('fade-in');
            } else {
                imagePreview.style.display = 'none';
            }
        }

        select.addEventListener('change', () => {
            calculateSubtotal();
            updateDishImage();
        });
        qtyInput.addEventListener('input', calculateSubtotal);
        window.addEventListener('DOMContentLoaded', () => {
            calculateSubtotal();
            updateDishImage();
        });
    </script>
}
