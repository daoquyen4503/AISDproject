@model IEnumerable<AISDproject.Models.OrderItem>

@{
    ViewData["Title"] = "Order Items";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="py-5">
    <div class="container" data-aos="fade-up">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">🧾 Order Items</h2>
            <a asp-action="Create" class="btn btn-danger rounded-pill px-4">
                <i class="bi bi-plus-circle me-1"></i> Create New
            </a>
        </div>

        <div class="card shadow-sm rounded-4 border-0">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>Order ID</th>
                                <th>Dish</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="text-center">
                                    <td><span class="fw-semibold">#@item.Order.OrderId</span></td>
                                    <td>@item.MenuItem?.Name</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-danger fw-bold">@item.Subtotal.ToString("C")</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill me-1">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill me-1">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No order items found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
