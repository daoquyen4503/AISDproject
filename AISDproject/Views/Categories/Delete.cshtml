@model AISDproject.Models.Category

@{
    ViewData["Title"] = "Delete Category";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="py-5">
    <div class="container" data-aos="fade-up">
        <div class="section-header text-center mb-4">
            <h2 class="fw-bold text-danger">Delete Category</h2>
            <p class="text-muted">Are you sure you want to delete this category?</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="bg-white shadow-lg p-4 rounded-4 border border-danger-subtle">
                    <h5 class="mb-3 fw-semibold">Category Details</h5>
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>
                    </dl>

                    <form asp-action="Delete">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CategoryId" />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to List</a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
