@model AISDproject.Models.Category

@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="py-5">
    <div class="container" data-aos="fade-up">
        <div class="section-header text-center mb-4">
            <h2 class="fw-bold text-danger">Create New Category</h2>
            <p class="text-muted">Add a new dish category to the menu</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="bg-white shadow-lg p-4 rounded-4">
                    <form asp-action="Create">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                            <input asp-for="Name" class="form-control rounded-pill px-3" placeholder="e.g. Desserts" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <input asp-for="Description" class="form-control rounded-pill px-3" placeholder="Optional description" />
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                                Back to List
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4">
                                Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
