@model AISDproject.Models.Category

@{
    ViewData["Title"] = "Category Details";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">Category Details</h2>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">Back to List</a>
        </div>

        <div class="card shadow-sm p-4 rounded-4 mb-4">
            <h5 class="fw-semibold mb-3">Basic Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>
        </div>

        @if (Model.MenuItems != null && Model.MenuItems.Any())
        {
            <div class="card shadow-sm p-4 rounded-4">
                <h5 class="fw-semibold mb-3">Dishes in this Category</h5>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>Dish Name</th>
                                <th>Price</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.MenuItems)
                            {
                                <tr class="text-center">
                                    <td>@item.Name</td>
                                    <td>@item.Price.ToString("N0") ₫</td>
                                    <td>
                                        <span class="badge @(item.Status ? "bg-success" : "bg-secondary")">
                                            @(item.Status ? "Available" : "Unavailable")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning mt-3">No dishes found in this category.</div>
        }

        <div class="mt-4 text-end">
            <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn btn-warning rounded-pill px-4">Edit</a>
        </div>

    </div>
</section>
