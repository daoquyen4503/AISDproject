@model AISDproject.Models.Payment

@{
    ViewData["Title"] = "Delete Payment";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card border-0 shadow rounded-4">
            <div class="card-body p-5">
                <h2 class="fw-bold text-danger mb-4">
                    <i class="bi bi-trash3 me-2"></i> Delete Payment
                </h2>

                <div class="alert alert-warning">
                    Are you sure you want to delete this payment?
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Payment Date</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.PaymentDate)</dd>

                    <dt class="col-sm-3">Amount</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Amount)</dd>

                    <dt class="col-sm-3">Payment Method</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.PaymentMethod)</dd>

                    <dt class="col-sm-3">Order</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Order.OrderId)</dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="PaymentId" />
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">← Back to List</a>
                        <input type="submit" value="Delete" class="btn btn-danger rounded-pill px-4" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
