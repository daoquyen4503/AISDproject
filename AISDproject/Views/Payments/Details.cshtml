@model AISDproject.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card shadow p-4 rounded-4 border-0 bg-light">
            <h2 class="text-center text-danger fw-bold mb-4">Payment Details</h2>

            <dl class="row mb-4">
                <dt class="col-sm-3 fw-semibold">Payment Date</dt>
                <dd class="col-sm-9">@Model.PaymentDate.ToString("g")</dd>

                <dt class="col-sm-3 fw-semibold">Amount</dt>
                <dd class="col-sm-9">@Model.Amount.ToString("N0") đ</dd>

                <dt class="col-sm-3 fw-semibold">Payment Method</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>

                <dt class="col-sm-3 fw-semibold">Order ID</dt>
                <dd class="col-sm-9">@Model.Order?.OrderId</dd>
            </dl>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
                <a asp-action="Edit" asp-route-id="@Model.PaymentId" class="btn btn-primary rounded-pill px-4">Edit</a>
            </div>
        </div>
    </div>
</section>
