@model AISDproject.Models.Payment

@{
    ViewData["Title"] = "Edit Payment";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">Edit Payment</h2>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back to List</a>
        </div>

        <form asp-action="Edit" method="post" class="card shadow p-4 border-0 rounded-4 bg-light">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="PaymentId" />

            <div class="mb-3">
                <label asp-for="PaymentDate" class="form-label fw-semibold">Payment Date</label>
                <input asp-for="PaymentDate" class="form-control rounded-pill" />
                <span asp-validation-for="PaymentDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-semibold">Amount</label>
                <input asp-for="Amount" class="form-control rounded-pill" />
                <span asp-validation-for="Amount" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-control rounded-pill"
                        asp-items="Html.GetEnumSelectList<AISDproject.Models.PaymentMethod>()">
                    <option value="">-- Select method --</option>
                </select>
                <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="OrderId" class="form-label fw-semibold">Order</label>
                <select asp-for="OrderId" class="form-control rounded-pill" asp-items="ViewBag.OrderId"></select>
                <span asp-validation-for="OrderId" class="text-danger small"></span>
            </div>

            <div class="text-end">
                <button type="submit" class="btn btn-danger rounded-pill px-4">Save Changes</button>
            </div>
        </form>
    </div>
</section>
