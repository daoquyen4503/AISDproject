@model AISDproject.Models.TimeSlot

@{
    ViewData["Title"] = "Time Slot Details";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<style>
    .details-bg {
        background: #f8f9fa;
        padding: 20px 0 40px;
    }

    .card-details {
        background-color: #ffffff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 30px 35px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
        max-width: 550px;
        margin: 0 auto;
    }

    .section-title {
        font-size: 24px;
        font-weight: 700;
        color: #1d3557;
        margin-bottom: 10px;
        text-align: center;
    }

    .btn-outline-secondary-custom {
        font-size: 14px;
        padding: 8px 20px;
        color: #6c757d;
        border: 1px solid #ced4da;
    }

        .btn-outline-secondary-custom:hover {
            background-color: #f1f3f5;
        }

    .btn-primary-custom {
        background-color: #c92a2a;
        border-color: #c92a2a;
        color: #fff;
        font-size: 14px;
        padding: 8px 24px;
        font-weight: 500;
    }

        .btn-primary-custom:hover {
            background-color: #a61e1e;
            border-color: #a61e1e;
        }

    dt {
        font-weight: 600;
        color: #444;
    }

    dd {
        margin-bottom: 1rem;
        color: #333;
    }
</style>

<section class="details-bg">
    <div class="container">
        <h2 class="section-title">Time Slot Details</h2>

        <div class="card-details">
            <dl class="row mb-0">
                <dt class="col-sm-4">Start Time</dt>
                <dd class="col-sm-8">@Model.StartTime.ToString("hh\\:mm")</dd>

                <dt class="col-sm-4">End Time</dt>
                <dd class="col-sm-8">@Model.EndTime.ToString("hh\\:mm")</dd>
            </dl>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary-custom rounded-pill">
                    ← Back
                </a>
                <a asp-action="Edit" asp-route-id="@Model.TimeSlotId" class="btn btn-primary-custom rounded-pill">
                    <i class="bi bi-pencil-square me-1"></i> Edit
                </a>
            </div>
        </div>
    </div>
</section>
