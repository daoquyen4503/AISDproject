@model AISDproject.Models.TimeSlot

@{
    ViewData["Title"] = "Delete Time Slot";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">
        <div class="card shadow p-4 rounded-4 border-0 bg-light">
            <h2 class="text-center text-danger fw-bold mb-4">Delete Time Slot</h2>

            <h5 class="text-warning text-center mb-4">Are you sure you want to delete this time slot?</h5>

            <dl class="row">
                <dt class="col-sm-4 fw-semibold">Start Time</dt>
                <dd class="col-sm-8">@Model.StartTime.ToString(@"hh\:mm")</dd>

                <dt class="col-sm-4 fw-semibold">End Time</dt>
                <dd class="col-sm-8">@Model.EndTime.ToString(@"hh\:mm")</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="TimeSlotId" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Back</a>
                    <input type="submit" value="Delete" class="btn btn-danger rounded-pill px-4" />
                </div>
            </form>
        </div>
    </div>
</section>
