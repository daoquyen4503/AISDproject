@model IEnumerable<AISDproject.Models.TimeSlot>

@{
    ViewData["Title"] = "Time Slots";
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<section class="section-bg py-5">
    <div class="container" data-aos="fade-up">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-danger mb-0">Manage Time Slots</h2>
            <a asp-action="Create" class="btn btn-danger rounded-pill shadow px-4 py-2">
                <i class="bi bi-plus-circle me-1"></i> Add New Slot
            </a>
        </div>

        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="text-center text-white" style="background-color: #dc3545;">
                            <tr>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">
                                        <i class="bi bi-exclamation-circle-fill me-2"></i> No time slots available.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">
                                            @(item.StartTime != default ? item.StartTime.ToString("hh\\:mm") : "-")
                                        </td>
                                        <td class="text-center">
                                            @(item.EndTime != default ? item.EndTime.ToString("hh\\:mm") : "-")
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a asp-action="Edit" asp-route-id="@item.TimeSlotId" class="btn btn-sm btn-outline-primary rounded-circle" title="Edit">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.TimeSlotId" class="btn btn-sm btn-outline-success rounded-circle" title="Details">
                                                    <i class="bi bi-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.TimeSlotId" class="btn btn-sm btn-outline-danger rounded-circle" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>
